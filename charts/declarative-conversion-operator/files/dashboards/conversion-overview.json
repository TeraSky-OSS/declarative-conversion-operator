{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Conversion latency p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, target) (rate(dco_webhook_conversion_review_duration_seconds_bucket[5m])))",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Conversion error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (target, result) (rate(dco_webhook_conversion_review_requests_total{result!=\"success\"}[5m]))",
          "legendFormat": "{{target}} {{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Registry size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "dco_webhook_registry_size",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Compile errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (target, reason) (rate(dco_webhook_registry_compile_errors_total[5m])) or vector(0)",
          "legendFormat": "{{target}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Webhook ready",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "expr": "dco_webhook_ready",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Registry entry loaded",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "expr": "dco_webhook_registry_entry_loaded",
          "legendFormat": "{{pod}} {{target}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Manager analyze failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (config_kind, target, reason) (rate(dco_manager_analyze_failures_total[5m])) or vector(0)",
          "legendFormat": "{{config_kind}} {{target}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Manager apply latency p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, config_kind, target) (rate(dco_manager_apply_duration_seconds_bucket[5m])))",
          "legendFormat": "{{config_kind}} {{target}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Phase transitions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (config_kind, from_phase, to_phase, reason) (rate(dco_manager_phase_transitions_total[5m])) or vector(0)",
          "legendFormat": "{{config_kind}} {{from_phase}}→{{to_phase}} ({{reason}})",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["declarative-conversion-operator", "conversion"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource",
        "refresh": 1
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Conversion Overview",
  "uid": "dco-conversion-overview",
  "version": 1
}
